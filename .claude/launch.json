{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8532"],
      "port": 8532
    },
    {
      "name": "stock-dashboard",
      "runtimeExecutable": "python",
